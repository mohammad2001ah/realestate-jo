  "item": [
    {
      "name": "01 - Registration",
      "item": [
        {
          "name": "Register QA User",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA User\",\n  \"email\": \"{{qaUserEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"role\": \"user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "const r=pm.response.json();",
                  "pm.test(\"User created message\",()=>pm.expect(r.message).to.eql(\"User created successfully\"));",
                  "pm.test(\"Token returned\",()=>pm.expect(r.token).to.be.a(\"string\").and.not.empty);",
                  "if (r.token) pm.collectionVariables.set(\"userToken\",r.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate Registration",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA User\",\n  \"email\": \"{{qaUserEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"role\": \"user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Duplicate message\",()=>pm.expect(pm.response.json().message).to.eql(\"User already exists\"));"
                ]
              }
            }
          ]
        },
        {
