          "  pm.collectionVariables.set(\"qaSuffix\", s);",
          "  pm.collectionVariables.set(\"qaUserEmail\", `qa.user.${s}@example.com`);",
          "  pm.collectionVariables.set(\"qaAgentEmail\", `qa.agent.${s}@example.com`);",
          "  pm.collectionVariables.set(\"securityAdminEmail\", `qa.admin.${s}@example.com`);",
          "  pm.collectionVariables.set(\"shortPasswordEmail\", `qa.short.${s}@example.com`);",
          "  pm.collectionVariables.set(\"invalidEmailValue\", `qa-invalid-${s}`);",
          "}"
        ]
      }
    }
