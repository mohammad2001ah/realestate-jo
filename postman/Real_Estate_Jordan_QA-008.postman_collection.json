    {
      "name": "08 - Frontend vs API Validation",
      "item": [
        {
          "name": "Short Password Should Match Frontend Rule",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Short Password\",\n  \"email\": \"{{shortPasswordEmail}}\",\n  \"password\": \"12345\",\n  \"role\": \"user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get(\"runSecurityWriteTests\") !== \"true\") {",
                  "  console.log(\"Skipped: set runSecurityWriteTests=true only on a local/test DB\");",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API should reject password shorter than 6\",()=>pm.expect([400,422]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
